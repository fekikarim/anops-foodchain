# =============================================================================
# AnOps FoodChain — .gitignore
# Safe for pushing to GitHub
# =============================================================================

# --- Node.js / npm ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json

# --- Truffle build artifacts ---
build/
*.abi
*.bin
*.bin-runtime
*.clones
*.metadata.json

# --- Frontend (Vite + React) build output ---
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# --- Environment files ---
.env
.env.local
.env.*.local

# --- Logs ---
logs/
*.log

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDE / Editors ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Truffle / Ganache ---
.development.json
truffle-config.local.js

# --- Misc ---
coverage/
.nyc_output/
tmp/
temp/
*.tar.gz
*.zip
